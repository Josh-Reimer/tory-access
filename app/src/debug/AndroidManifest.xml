<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only automation hooks for driving the app from adb / Shizuku (rish).
     Guarded by android.permission.DUMP, which the shell user (uid 2000) holds and
     ordinary apps can't get — so other apps can't type into your SSH sessions. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.joshreimer.toryaccess.debug.AutomationReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
